# developer-docs
#
# This file is the source of truth for the variables this repo reads.
# Copy it to .env and uncomment what you need. Shell variables override .env.

# URL path the site is served from. Default: /developer-docs (GitHub Pages).
# Set it empty to build for the site root. `pnpm preview` always builds for the root.
# BASE_PATH=

# Local clone of the private client-sdk-web repo. Required by `pnpm sync:sdk`.
# SDK_REPO=../client-sdk-web

# Branch, tag or commit of SDK_REPO to sync from. Default: HEAD.
# SDK_REF=main
